{%- assign grouped_sectors = site.arg | group_by: "sector" -%}
{
{%- for sector in grouped_sectors -%}
  {%- assign sector_name = sector.name | strip -%}
  {%- if sector_name == "" %}{% continue %}{% endif -%}
  "{{ sector_name }}": {
    {%- assign grouped_agents = sector.items | group_by: "agent" -%}
    {%- for agent in grouped_agents -%}
      {%- assign agent_name = agent.name | strip -%}
      {%- if agent_name == "" %}{% continue %}{% endif -%}
      "{{ agent_name }}": {
        "files": [{%- for item in agent.items -%}{%- assign f = item.filename | strip -%}{%- if f == "" %}{% continue %}{% endif -%}"{{ f }}"{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
        "content": {
          {%- for item in agent.items -%}
            {%- assign f = item.filename | strip -%}
            {%- if f == "" %}{% continue %}{% endif -%}
            "{{ f }}": {{ item.terminal_stream | strip_newlines | jsonify }}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
}
